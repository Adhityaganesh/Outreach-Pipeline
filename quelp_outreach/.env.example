# Copy this to .env and fill in real values
# Optional — without it, openers use a safe template line
GROQ_API_KEY=
# Groq chat model — list yours at https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
SENDER_NAME=Adhitya
# From-line name, e.g. "Adhitya from Quelp" (defaults to SENDER_NAME)
SENDER_DISPLAY_NAME=
SENDER_TITLE=Founder, Quelp
SENDER_SITE=quelp.co.in

# Set to false while running cold outreach: the header marks mail as bulk, which
# can cost inbox placement. The P.S. opt-out line in pitch.py applies either way.
LIST_UNSUBSCRIBE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — only for headless machines
GOOGLE_REFRESH_TOKEN=

# Sending inboxes (optional). Connect each with `python inbox.py add`, then list
# them here with an optional per-inbox daily cap. Empty = the single token.json account.
# INBOXES=adhitya@getquelp.com:15,team@getquelp.com:10
INBOXES=

# Send throttle. New domain: keep the cap at 10–15/day per inbox for 2–3 weeks.
# The cap is per inbox, per day across ALL runs, first emails + follow-ups combined.
DAILY_SEND_CAP=15
SEND_DELAY_MIN=40
SEND_DELAY_MAX=90
FOLLOWUP_DAYS=3

# ICP size gate for list_send.py (rows with unknown size are kept)
MIN_EMPLOYEES=20
MAX_EMPLOYEES=200

# Lead finding — find_emails.py (Prospeo search → guess → Clearout verify)
PROSPEO_API_KEY=
CLEAROUT_API_KEY=
# Check the base URL under Clearout → Developer → Reference
CLEAROUT_BASE_URL=https://api.clearout.io/v2
# Max Clearout credits per run
CLEAROUT_CREDIT_CAP=50
GUESS_PATTERNS=first.last,first,firstlast

# Legacy blocks 0–3 only (scraping + enrichment)
APIFY_TOKEN=
APOLLO_API_KEY=
HUNTER_KEY=
GETPROSPECT_KEY=
TOMBA_KEY=
TOMBA_SECRET=
