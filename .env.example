# Copy this to .env and fill in real values
GROQ_API_KEY=            # optional — without it, openers use a safe template line
SENDER_NAME=Adhitya
SENDER_TITLE=Founder, Quelp
SENDER_SITE=quelp.co.in

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=    # optional — only for headless machines

# Send throttle. New domain: keep the cap at 10–15/day for 2–3 weeks.
# The cap is per day across ALL runs, first emails + follow-ups combined.
DAILY_SEND_CAP=15
SEND_DELAY_MIN=40
SEND_DELAY_MAX=90
FOLLOWUP_DAYS=3

# ICP size gate for list_send.py (rows with unknown size are kept)
MIN_EMPLOYEES=20
MAX_EMPLOYEES=200

# Legacy blocks 0–3 only (scraping + enrichment)
APIFY_TOKEN=
APOLLO_API_KEY=
HUNTER_KEY=
GETPROSPECT_KEY=
TOMBA_KEY=
TOMBA_SECRET=
